generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                          String             @id
  username                                                    String             @unique
  passwordHash                                                String?            @map("password")
  fullName                                                    String?            @map("fullName")
  role                                                        UserRole
  createdAt                                                   DateTime           @default(now()) @map("createdAt")
  updatedAt                                                   DateTime           @map("updatedAt")
  lastLogin                                                   DateTime?          @map("lastLogin")
  email                                                       String?            @unique @map("email")
  is_active                                                   Boolean            @default(true)
  activity_logs                                               ActivityLog[]
  discrepancy_alerts_discrepancy_alerts_acknowledgedByTousers DiscrepancyAlert[] @relation("discrepancy_alerts_acknowledgedByTousers")
  discrepancy_alerts_discrepancy_alerts_reportedByTousers     DiscrepancyAlert[] @relation("discrepancy_alerts_reportedByTousers")
  discrepancy_alerts_discrepancy_alerts_resolvedByTousers     DiscrepancyAlert[] @relation("discrepancy_alerts_resolvedByTousers")
  logbook_entries                                             LogbookEntry[]
  pols                                                        POL[]              @relation("POLCreatedBy")
  production_records                                          ProductionRecord[]
  revision_tickets_revision_tickets_approvedByTousers         RevisionTicket[]   @relation("revision_tickets_approvedByTousers")
  revision_tickets_revision_tickets_createdByTousers          RevisionTicket[]   @relation("revision_tickets_createdByTousers")

  @@map("users")
}

model POL {
  id                 String             @id
  poNumber           String             @unique @map("polNumber")
  clientName         String             @map("customerName")
  poDate             DateTime           @default(now()) @map("orderDate")
  deliveryDate       DateTime           @map("deliveryDate")
  status             POLStatus          @default(PENDING)
  notes              String?            @map("notes")
  createdBy          String             @map("createdBy")
  createdAt          DateTime           @default(now()) @map("createdAt")
  updatedAt          DateTime           @updatedAt @map("updatedAt")
  discrepancy_alerts DiscrepancyAlert[]
  logbook_entries    LogbookEntry[]
  polDetails         POLDetail[]
  creator            User               @relation("POLCreatedBy", fields: [createdBy], references: [id])
  revision_tickets   RevisionTicket[]

  @@map("pols")
}

model POLDetail {
  id                 String             @id
  polId              String             @map("polId")
  productCode        String             @map("productCode")
  productName        String             @map("productName")
  quantity           Int
  productType        String             @default("PLAIN") @map("productType")
  color              String?
  texture            String?
  material           String?
  size               String?
  finalSize          String?            @map("finalSize")
  notes              String?
  createdAt          DateTime           @default(now()) @map("createdAt")
  updatedAt          DateTime           @updatedAt @map("updatedAt")
  decoration_tasks   DecorationTask[]
  discrepancy_alerts DiscrepancyAlert[]
  logbook_entries    LogbookEntry[]
  pol                POL                @relation(fields: [polId], references: [id], onDelete: Cascade)
  production_records ProductionRecord[]
  revision_tickets   RevisionTicket[]
  product_parts      ProductPart[]

  @@map("pol_details")
}

model ProductionRecord {
  id          String          @id
  polDetailId String
  stage       ProductionStage
  quantity    Int
  userId      String
  notes       String?
  createdAt   DateTime        @default(now()) @map("createdAt")
  updatedAt   DateTime        @updatedAt @map("updatedAt")
  pol_details POLDetail       @relation(fields: [polDetailId], references: [id], onDelete: Cascade)
  users       User            @relation(fields: [userId], references: [id])

  @@map("production_records")
}

model DecorationTask {
  id          String    @id
  polDetailId String
  taskName    String
  description String?
  quantity    Int       @default(0)
  completed   Boolean   @default(false)
  userId      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now()) @map("createdAt")
  updatedAt   DateTime  @updatedAt @map("updatedAt")
  pol_details POLDetail @relation(fields: [polDetailId], references: [id], onDelete: Cascade)

  @@map("decoration_tasks")
}

model DiscrepancyAlert {
  id                                             String          @id
  polId                                          String
  polDetailId                                    String
  stage                                          ProductionStage
  expectedQuantity                               Int
  actualQuantity                                 Int
  difference                                     Int
  priority                                       AlertPriority   @default(MEDIUM)
  status                                         AlertStatus     @default(OPEN)
  reportedBy                                     String
  acknowledgedBy                                 String?
  acknowledgedAt                                 DateTime?
  resolvedBy                                     String?
  resolvedAt                                     DateTime?
  resolutionNotes                                String?
  createdAt                                      DateTime        @default(now()) @map("createdAt")
  updatedAt                                      DateTime        @updatedAt @map("updatedAt")
  users_discrepancy_alerts_acknowledgedByTousers User?           @relation("discrepancy_alerts_acknowledgedByTousers", fields: [acknowledgedBy], references: [id])
  pol_details                                    POLDetail       @relation(fields: [polDetailId], references: [id], onDelete: Cascade)
  pols                                           POL             @relation(fields: [polId], references: [id], onDelete: Cascade)
  users_discrepancy_alerts_reportedByTousers     User            @relation("discrepancy_alerts_reportedByTousers", fields: [reportedBy], references: [id])
  users_discrepancy_alerts_resolvedByTousers     User?           @relation("discrepancy_alerts_resolvedByTousers", fields: [resolvedBy], references: [id])

  @@map("discrepancy_alerts")
}

model LogbookEntry {
  id          String     @id
  polId       String?
  polDetailId String?
  userId      String
  entryDate   DateTime
  status      LogStatus  @default(NORMAL)
  notes       String
  issues      String?
  actions     String?
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")
  pol_details POLDetail? @relation(fields: [polDetailId], references: [id])
  pols        POL?       @relation(fields: [polId], references: [id])
  users       User       @relation(fields: [userId], references: [id])

  @@map("logbook_entries")
}

model RevisionTicket {
  id                                       String         @id
  polId                                    String
  polDetailId                              String?
  createdBy                                String
  type                                     RevisionType
  issueType                                String
  severity                                 Severity
  description                              String
  proposedSolution                         String?
  status                                   RevisionStatus @default(DRAFT)
  submittedAt                              DateTime?
  approvedBy                               String?
  approvedAt                               DateTime?
  managerNotes                             String?
  createdAt                                DateTime       @default(now()) @map("createdAt")
  updatedAt                                DateTime       @updatedAt @map("updatedAt")
  users_revision_tickets_approvedByTousers User?          @relation("revision_tickets_approvedByTousers", fields: [approvedBy], references: [id])
  users_revision_tickets_createdByTousers  User           @relation("revision_tickets_createdByTousers", fields: [createdBy], references: [id])
  pol_details                              POLDetail?     @relation(fields: [polDetailId], references: [id])
  pols                                     POL            @relation(fields: [polId], references: [id])

  @@map("revision_tickets")
}

model ActivityLog {
  id         String   @id
  userId     String
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @map("createdAt")
  users      User     @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model ProductPart {
  id              String   @id
  polDetailId     String
  partName        String
  partType        String   @default("MAIN")
  throwingRequired Boolean  @default(true)
  throwingOrder   Int?
  createdAt       DateTime @default(now()) @map("createdAt")
  updatedAt       DateTime @updatedAt @map("updatedAt")
  pol_details     POLDetail @relation(fields: [polDetailId], references: [id], onDelete: Cascade)

  @@map("product_parts")
}

model Oven {
  id          String   @id
  ovenCode    String   @unique
  ovenName    String?
  status      String   @default("ACTIVE")
  capacity    Int?
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  @@map("ovens")
}

model DefectReason {
  id          String   @id
  category    String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  @@map("defect_reasons")
}

model StageCategory {
  id        String   @id
  code      String   @unique
  name      String
  color     String   @default("#4caf50")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stages    ProductionStageConfig[]

  @@map("stage_categories")
}

model ProductionStageConfig {
  id                String        @id
  code              String        @unique
  name              String
  categoryId        String
  sortOrder         Int           @default(0)
  isActive          Boolean       @default(true)
  requiresOven      Boolean       @default(false)
  hasDetailProcess  Boolean       @default(false)
  description       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  category          StageCategory @relation(fields: [categoryId], references: [id])
  detailProcesses   StageDetailProcess[]

  @@map("production_stage_configs")
}

model StageDetailProcess {
  id          String                @id
  stageId     String
  processName String
  sortOrder   Int                   @default(0)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  stage       ProductionStageConfig @relation(fields: [stageId], references: [id])

  @@map("stage_detail_processes")
}

enum UserRole {
  MANAGER
  ADMIN
  WORKER
}

enum POLStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionStage {
  THROWING
  TRIMMING
  DECORATION
  DRYING
  LOAD_BISQUE
  OUT_BISQUE
  LOAD_HIGH_FIRING
  OUT_HIGH_FIRING
  SANDING
  DIPPING
  QC_GOOD
  FORMING
  FIRING
  GLAZING
  QUALITY_CONTROL
  PACKAGING
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IssueType {
  MATERIAL_ISSUE
  TOOL_ISSUE
  PROCESS_ISSUE
  QUALITY_ISSUE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum LogStatus {
  NORMAL
  ISSUES
  RESOLVED
}

enum RevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RevisionType {
  DESIGN
  PRODUCTION
  MATERIAL
  OTHER
}
